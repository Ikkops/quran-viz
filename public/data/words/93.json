[[["wal-ḍuḥā","By the morning brightness","demi matahari naik","N|M|GEN",2136,926]],[["wa-al-layli","And the night","dan malam","N|M|GEN",677,206],["idhā","when","apabila","T",72,0],["sajā","it covers with darkness","telah sunyi","V|PERF|3MS",4762,1622]],[["mā","Not","tidak","NEG",37,0],["waddaʿaka","has forsaken you","meninggalkan kamu","V|PERF|(II)|3MS",4763,870],["rabbuka","your Lord","Tuhanmu","N|M|NOM",6,5],["wamā","and not","dan tidak","NEG",37,0],["qalā","He is displeased","marah/benci","V|PERF|3MS",4764,1357]],[["walalākhiratu","And surely the Hereafter","dan sungguh kesudahan/akhirat","N|FS|NOM",41,29],["khayrun","(is) better","lebih baik","N|MS|INDEF|NOM",315,212],["laka","for you","bagimu","PRON|2MS",0,0],["mina","than","dari pada","P",34,0],["l-ūlā","the first","permulaan/dunia","N|F|GEN",258,174]],[["walasawfa","And soon","dan sungguh kelak","FUT",1509,0],["yuʿ'ṭīka","will give you","memberikan kepadamu","V|IMPF|(IV)|3MS",2336,990],["rabbuka","your Lord","Tuhanmu","N|M|NOM",6,5],["fatarḍā","then you will be satisfied","maka kamu jadi puas","V|IMPF|2MS",579,361]],[["alam","Did not","apakah tidak/bukanlah","NEG",50,0],["yajid'ka","He find you","Dia mendapatimu","V|IMPF|3MS|MOOD:JUS",497,324],["yatīman","an orphan","seorang yatim","N|MS|INDEF|ACC",450,299],["faāwā","and give shelter","lalu Dia melindungi","V|PERF|(IV)|3MS",2261,670]],[["wawajadaka","And He found you","dan Dia mendapatimu","V|PERF|3MS",497,324],["ḍāllan","lost","sesat/bingung","N|ACT|PCPL|M|INDEF|ACC",23,18],["fahadā","so He guided","lalu Dia memberi petunjuk","V|PERF|3MS",14,12]],[["wawajadaka","And He found you","dan Dia mendapatimu","V|PERF|3MS",497,324],["ʿāilan","in need","miskin/kekurangan","N|ACT|PCPL|M|INDEF|ACC",4765,989],["fa-aghnā","so He made self-sufficient","lalu Dia memberi kecukupan","V|PERF|3MS",2088,558]],[["fa-ammā","So as for","maka adapun","EXL",179,0],["l-yatīma","the orphan","anak yatim","N|MS|ACC",450,299],["falā","then (do) not","maka jangan","PRO",22,0],["taqhar","oppress","kamu paksa/bersikap bengis","V|IMPF|2MS|MOOD:JUS",4766,834]],[["wa-ammā","And as for","dan adapun","EXL",179,0],["l-sāila","one who asks","orang minta-minta","N|ACT|PCPL|M|ACC",716,250],["falā","then (do) not","maka jangan","PRO",22,0],["tanhar","repel","kamu menghardik","V|IMPF|2MS|MOOD:JUS",2949,115]],[["wa-ammā","But as for","dan adapun","EXL",179,0],["biniʿ'mati","(the) Favor","dengan/terhadap nikmat","N|F|GEN",254,15],["rabbika","(of) your Lord","Tuhanmu","N|M|GEN",6,5],["faḥaddith","narrate","maka hendaklah kamu ceritakan","V|IMPV|(II)|2MS",430,290]]]